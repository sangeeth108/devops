pipeline {
    agent any
    
    parameters {
        booleanParam(defaultValue: false, description: 'Force build and deployment of images', name: 'FORCE_BUILD')
        booleanParam(defaultValue: false, description: 'First run - build all images', name: 'FIRST_RUN')
        string(defaultValue: 'default', description: 'Kubernetes namespace to deploy to', name: 'K8S_NAMESPACE')
    }
    
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        BACKEND_IMAGE = "sangeeth108/express-backend"
        FRONTEND_IMAGE = "sangeeth108/nextjs-frontend"
        DOCKER_BUILDKIT = '0'
        FIRST_RUN = "${params.FIRST_RUN}"
        K8S_NAMESPACE = "${params.K8S_NAMESPACE}"
        // Store the current build number for use in Kubernetes manifests
        CURRENT_BUILD_NUMBER = "${BUILD_NUMBER}"
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        
        stage('DockerHub Login') {
            steps {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
            }
        }
        
        stage('Build and Push Backend Image') {
            when {
                anyOf {
                    changeset "Food Ordering Platform/backend/**"
                    expression { return params.FORCE_BUILD == true }
                    expression { return env.FIRST_RUN == 'true' }
                }
            }
            steps {
                dir('Food Ordering Platform/backend') {
                    sh '''
                        # Check if directory exists
                        if [ -d "." ]; then
                            # Build and tag with both build number and latest
                            docker build -t ${BACKEND_IMAGE}:${BUILD_NUMBER} -t ${BACKEND_IMAGE}:latest .
                            docker push ${BACKEND_IMAGE}:${BUILD_NUMBER}
                            docker push ${BACKEND_IMAGE}:latest
                            
                            # Store the current build number for backend
                            echo ${BUILD_NUMBER} > ../../backend-version.txt
                        else
                            echo "Backend directory not found, skipping build"
                        fi
                    '''
                }
            }
        }
        
        stage('Build and Push Frontend Image') {
            when {
                anyOf {
                    changeset "Food Ordering Platform/frontend/**"
                    expression { return params.FORCE_BUILD == true }
                    expression { return env.FIRST_RUN == 'true' }
                }
            }
            steps {
                dir('Food Ordering Platform/frontend') {
                    sh '''
                        # Check if directory exists
                        if [ -d "." ]; then
                            # Build and tag with both build number and latest
                            docker build -t ${FRONTEND_IMAGE}:${BUILD_NUMBER} -t ${FRONTEND_IMAGE}:latest .
                            docker push ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                            docker push ${FRONTEND_IMAGE}:latest
                            
                            # Store the current build number for frontend
                            echo ${BUILD_NUMBER} > ../../frontend-version.txt
                        else
                            echo "Frontend directory not found, skipping build"
                        fi
                    '''
                }
            }
        }
        
        stage('DockerHub Logout') {
            steps {
                sh 'docker logout'
            }
        }
        
        stage('Determine Image Versions') {
            steps {
                script {
                    // Default to current build number
                    env.BACKEND_VERSION = env.BUILD_NUMBER
                    env.FRONTEND_VERSION = env.BUILD_NUMBER
                    
                    // Check if we have stored version files and read them
                    sh '''
                        if [ -f "backend-version.txt" ]; then
                            BACKEND_VERSION=$(cat backend-version.txt)
                            echo "Using backend version: ${BACKEND_VERSION}"
                        else
                            echo "No backend version file found, using current build: ${BUILD_NUMBER}"
                        fi
                        
                        if [ -f "frontend-version.txt" ]; then
                            FRONTEND_VERSION=$(cat frontend-version.txt)
                            echo "Using frontend version: ${FRONTEND_VERSION}"
                        else
                            echo "No frontend version file found, using current build: ${BUILD_NUMBER}"
                        fi
                    '''
                    
                    // Read the values back from the shell into environment variables
                    env.BACKEND_VERSION = sh(script: "cat backend-version.txt 2>/dev/null || echo ${BUILD_NUMBER}", returnStdout: true).trim()
                    env.FRONTEND_VERSION = sh(script: "cat frontend-version.txt 2>/dev/null || echo ${BUILD_NUMBER}", returnStdout: true).trim()
                }
            }
        }
        
        stage('Create Kubernetes Manifests') {
            steps {
                sh 'mkdir -p kubernetes'
                
                // Create frontend deployment file - now using the determined version
                writeFile file: 'kubernetes/frontend-deployment.yaml', text: """
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  labels:
    app: frontend
    app.kubernetes.io/part-of: food-ordering-app
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      containers:
      - name: frontend
        image: ${FRONTEND_IMAGE}:${FRONTEND_VERSION}
        imagePullPolicy: Always
        ports:
        - containerPort: 3000
---
apiVersion: v1
kind: Service
metadata:
  name: frontend-service
  labels:
    app: frontend
spec:
  selector:
    app: frontend
  ports:
  - port: 80
    targetPort: 3000
  type: LoadBalancer
"""
                
                // Create backend deployment file - now using the determined version
                writeFile file: 'kubernetes/backend-deployment.yaml', text: """
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  labels:
    app: backend
spec:
  replicas: 2
  selector:
    matchLabels:
      app: backend
  template:
    metadata:
      labels:
        app: backend
    spec:
      containers:
      - name: backend
        image: ${BACKEND_IMAGE}:${BACKEND_VERSION}
        imagePullPolicy: Always
        ports:
        - containerPort: 5000
---
apiVersion: v1
kind: Service
metadata:
  name: backend-service
  labels:
    app: backend
spec:
  selector:
    app: backend
  ports:
  - port: 5000
    targetPort: 5000
  type: ClusterIP
"""
                
                // Create kustomization file
                writeFile file: 'kubernetes/kustomization.yaml', text: """
apiVersion: kustomize.config.k8s.io/v1beta1
kind: Kustomization

resources:
  - frontend-deployment.yaml
  - backend-deployment.yaml

namePrefix: food-app-

namespace: ${K8S_NAMESPACE}

commonLabels:
  app.kubernetes.io/part-of: food-ordering-app
  app.kubernetes.io/managed-by: jenkins
"""
                
                echo "Kubernetes manifests created in 'kubernetes/' directory"
                echo "To deploy manually, run: kubectl apply -k kubernetes/"
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                echo "Deploying to Kubernetes namespace: ${K8S_NAMESPACE}"
                sh '''
                    # Check if namespace exists, create if not
                    kubectl get namespace ${K8S_NAMESPACE} || kubectl create namespace ${K8S_NAMESPACE}
                    
                    # Apply the Kubernetes manifests
                    kubectl apply -k kubernetes/
                    
                    # Wait for deployments to be ready
                    kubectl rollout status deployment food-app-frontend -n ${K8S_NAMESPACE}
                    kubectl rollout status deployment food-app-backend -n ${K8S_NAMESPACE}
                '''
            }
        }
    }
    
    post {
        always {
            echo "Pipeline completed"
        }
        success {
            echo "Deployment successful. Application is now running in namespace: ${K8S_NAMESPACE}"
            echo "Frontend should be accessible via LoadBalancer service"
        }
        failure {
            echo "Pipeline failed. Check logs for details."
        }
    }
}