pipeline {
    agent any
    
    parameters {
        booleanParam(defaultValue: false, description: 'Force build and deployment of images', name: 'FORCE_BUILD')
        booleanParam(defaultValue: false, description: 'First run - build all images', name: 'FIRST_RUN')
        string(defaultValue: 'default', description: 'Kubernetes namespace to deploy to', name: 'K8S_NAMESPACE')
    }
    
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        KUBECONFIG = credentials('kube-config')
        BACKEND_IMAGE = "sangeeth108/express-backend"
        FRONTEND_IMAGE = "sangeeth108/nextjs-frontend"
        DOCKER_BUILDKIT = '0'
        FIRST_RUN = "${params.FIRST_RUN}"
        K8S_NAMESPACE = "${params.K8S_NAMESPACE}"
        K8S_MANIFESTS_DIR = "${WORKSPACE}/k8s-manifests"
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        
        stage('DockerHub Login') {
            steps {
                sh 'echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin'
            }
        }
        
        stage('Build and Push Images') {
            parallel {
                stage('Backend') {
                    when {
                        anyOf {
                            changeset "Food Ordering Platform/backend/**"
                            expression { return params.FORCE_BUILD == true }
                            expression { return env.FIRST_RUN == 'true' }
                        }
                    }
                    steps {
                        dir('Food Ordering Platform/backend') {
                            sh '''
                                if [ -d "." ]; then
                                    docker build -t ${BACKEND_IMAGE}:${BUILD_NUMBER} -t ${BACKEND_IMAGE}:latest .
                                    docker push ${BACKEND_IMAGE}:${BUILD_NUMBER}
                                    docker push ${BACKEND_IMAGE}:latest
                                else
                                    echo "Backend directory not found, skipping build"
                                fi
                            '''
                        }
                    }
                }
                
                stage('Frontend') {
                    when {
                        anyOf {
                            changeset "Food Ordering Platform/frontend/**"
                            expression { return params.FORCE_BUILD == true }
                            expression { return env.FIRST_RUN == 'true' }
                        }
                    }
                    steps {
                        dir('Food Ordering Platform/frontend') {
                            sh '''
                                if [ -d "." ]; then
                                    docker build -t ${FRONTEND_IMAGE}:${BUILD_NUMBER} -t ${FRONTEND_IMAGE}:latest .
                                    docker push ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                                    docker push ${FRONTEND_IMAGE}:latest
                                else
                                    echo "Frontend directory not found, skipping build"
                                fi
                            '''
                        }
                    }
                }
            }
        }
        
        stage('Prepare K8s Manifests') {
            steps {
                sh 'mkdir -p ${K8S_MANIFESTS_DIR}'
                
                script {
                    // Check if kubernetes directory exists in the repo
                    def k8sDirExists = fileExists('kubernetes')
                    
                    if (k8sDirExists) {
                        sh 'cp kubernetes/*.yaml ${K8S_MANIFESTS_DIR}/ || echo "No yaml files found"'
                    } else {
                        // Create basic manifests if they don't exist
                        writeFile file: "${K8S_MANIFESTS_DIR}/frontend-deployment.yaml", text: """
apiVersion: apps/v1
kind: Deployment
metadata:
  name: frontend
  labels:
    app: frontend
spec:
  replicas: 2
  selector:
    matchLabels:
      app: frontend
  template:
    metadata:
      labels:
        app: frontend
    spec:
      containers:
      - name: frontend
        image: ${FRONTEND_IMAGE}:latest
        ports:
        - containerPort: 3000
---
apiVersion: v1
kind: Service
metadata:
  name: frontend-service
spec:
  selector:
    app: frontend
  ports:
  - port: 80
    targetPort: 3000
  type: LoadBalancer
"""

                        writeFile file: "${K8S_MANIFESTS_DIR}/backend-deployment.yaml", text: """
apiVersion: apps/v1
kind: Deployment
metadata:
  name: backend
  labels:
    app: backend
spec:
  replicas: 2
  selector:
    matchLabels:
      app: backend
  template:
    metadata:
      labels:
        app: backend
    spec:
      containers:
      - name: backend
        image: ${BACKEND_IMAGE}:latest
        ports:
        - containerPort: 5000
---
apiVersion: v1
kind: Service
metadata:
  name: backend-service
spec:
  selector:
    app: backend
  ports:
  - port: 5000
    targetPort: 5000
  type: ClusterIP
"""
                    }
                    
                    // Update image tags
                    if (params.FORCE_BUILD || env.FIRST_RUN == 'true' || 
                        sh(script: "git diff --name-only | grep 'Food Ordering Platform/backend/'", returnStatus: true) == 0) {
                        sh "sed -i 's|${BACKEND_IMAGE}:[a-zA-Z0-9_.-]*|${BACKEND_IMAGE}:${BUILD_NUMBER}|g' ${K8S_MANIFESTS_DIR}/backend-deployment.yaml || true"
                    }
                    
                    if (params.FORCE_BUILD || env.FIRST_RUN == 'true' || 
                        sh(script: "git diff --name-only | grep 'Food Ordering Platform/frontend/'", returnStatus: true) == 0) {
                        sh "sed -i 's|${FRONTEND_IMAGE}:[a-zA-Z0-9_.-]*|${FRONTEND_IMAGE}:${BUILD_NUMBER}|g' ${K8S_MANIFESTS_DIR}/frontend-deployment.yaml || true"
                    }
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                sh """
                    export KUBECONFIG=${KUBECONFIG}
                    
                    # Create namespace if it doesn't exist
                    kubectl create namespace ${K8S_NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -
                    
                    # Apply Deployments and Services
                    kubectl apply -f ${K8S_MANIFESTS_DIR}/backend-deployment.yaml -n ${K8S_NAMESPACE} || true
                    kubectl apply -f ${K8S_MANIFESTS_DIR}/frontend-deployment.yaml -n ${K8S_NAMESPACE} || true
                    
                    # Apply network policy if it exists
                    if [ -f "${K8S_MANIFESTS_DIR}/network-policy.yaml" ]; then
                        kubectl apply -f ${K8S_MANIFESTS_DIR}/network-policy.yaml -n ${K8S_NAMESPACE} || true
                    fi
                    
                    # Wait for deployments to roll out
                    kubectl rollout status deployment/backend -n ${K8S_NAMESPACE} --timeout=180s || true
                    kubectl rollout status deployment/frontend -n ${K8S_NAMESPACE} --timeout=180s || true
                    
                    # Get service details
                    echo "Backend Service:"
                    kubectl get service backend-service -n ${K8S_NAMESPACE} -o wide || true
                    
                    echo "Frontend Service:"
                    kubectl get service frontend-service -n ${K8S_NAMESPACE} -o wide || true
                """
            }
        }
    }
    
    post {
        always {
            sh 'docker logout || true'
        }
        success {
            echo 'Kubernetes deployment completed successfully!'
            
            script {
                try {
                    sh """
                        export KUBECONFIG=${KUBECONFIG}
                        
                        # Get frontend service URL
                        FRONTEND_URL=\$(kubectl get service frontend-service -n ${K8S_NAMESPACE} -o jsonpath='{.status.loadBalancer.ingress[0].ip}' 2>/dev/null || echo '')
                        if [ -z "\$FRONTEND_URL" ]; then
                            FRONTEND_URL=\$(kubectl get service frontend-service -n ${K8S_NAMESPACE} -o jsonpath='{.status.loadBalancer.ingress[0].hostname}' 2>/dev/null || echo '')
                        fi
                        
                        if [ ! -z "\$FRONTEND_URL" ]; then
                            echo "Frontend is available at: http://\$FRONTEND_URL"
                        else
                            echo "Frontend service is deployed but doesn't have an external IP yet"
                            echo "Check service status: kubectl get service frontend-service -n ${K8S_NAMESPACE}"
                        fi
                        
                        echo "Backend service is accessible within the cluster at: backend-service:5000"
                    """
                } catch (Exception e) {
                    echo "Error getting service details: ${e.message}"
                    echo "You may need to manually check the service status"
                }
            }
            
            echo "\nTo force build of images on next run, use the FORCE_BUILD parameter."
            echo "For first-time setup, use the FIRST_RUN parameter."
        }
        failure {
            echo 'Pipeline failed. Check logs for details.'
            echo 'Common Kubernetes issues:'
            echo ' - Missing KUBECONFIG credentials'
            echo ' - Insufficient permissions in the Kubernetes cluster'
            echo ' - Resource limits exceeded in cluster'
            echo ' - Container image pull failures'
            echo 'Try running with FIRST_RUN=true if this is your first pipeline run.'
        }
    }
}