pipeline {
    agent any
    
    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        TERRAFORM_DIR = "/opt/jenkins-shared/terraform"
        ANSIBLE_DIR = "/opt/jenkins-shared/ansible" 
        BACKEND_IMAGE = "sangeeth108/express-backend"
        FRONTEND_IMAGE = "sangeeth108/nextjs-frontend"
        SERVER_IP = "localhost"
        DOCKER_BUILDKIT = '0'
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }
        
        stage('Infrastructure Setup') {
            stages {
                stage('Terraform Init') {
                    steps {
                        dir("${TERRAFORM_DIR}") {
                            sh 'terraform init'
                        }
                    }
                }
                
                stage('Terraform Apply') {
                    steps {
                        dir("${TERRAFORM_DIR}") {
                            sh 'terraform apply -auto-approve'
                            script {
                                sh 'echo "Using local Docker setup"'
                            }
                        }
                    }
                }
                
                stage('Configure Docker with Ansible') {
                    steps {
                        dir("${ANSIBLE_DIR}") {
                            sh 'ansible-playbook -i inventory.ini setup_docker.yml'
                        }
                    }
                }
            }
        }
        
        stage('DockerHub Login') {
            steps {
                script {
                    sh '''
                        echo $DOCKERHUB_CREDENTIALS_PSW | docker login -u $DOCKERHUB_CREDENTIALS_USR --password-stdin
                    '''
                }
            }
        }
        
        stage('Build, Push Backend Image') {
            when {
                changeset "Food Ordering Platform/backend/**"
            }
            steps {
                dir('Food Ordering Platform/backend') {
                    sh '''
                        docker build -t ${BACKEND_IMAGE}:${BUILD_NUMBER} .
                        docker push ${BACKEND_IMAGE}:${BUILD_NUMBER}
                    '''
                }
            }
        }
        
        stage('Build and Push Frontend Image') {
            when {
                changeset "Food Ordering Platform/frontend/**"
            }
            steps {
                dir('Food Ordering Platform/frontend') {
                    sh '''
                        docker build -t ${FRONTEND_IMAGE}:${BUILD_NUMBER} .
                        docker push ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                    '''
                }
            }
        }
        
        stage('DockerHub Logout') {
            steps {
                sh 'docker logout'
            }
        }
        
        stage('Deploy to Local Docker') {
            steps {
                script {
                    sh '''
                        # Pull the latest images
                        docker pull ${BACKEND_IMAGE}:${BUILD_NUMBER}
                        docker pull ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                        
                        # Remove existing containers if they exist
                        docker rm -f backend || true
                        docker rm -f frontend || true
                        
                        # Run new containers
                        docker run -d -p 5000:5000 --name backend --network food-app-network ${BACKEND_IMAGE}:${BUILD_NUMBER}
                        docker run -d -p 3000:3000 --name frontend --network food-app-network ${FRONTEND_IMAGE}:${BUILD_NUMBER}
                        
                        # Verify running containers
                        docker ps
                    '''
                }
            }
        }
    }
    
    post {
        always {
            sh 'docker logout'
        }
        success {
            echo 'Full CI/CD pipeline completed successfully!'
            echo "Application deployed locally"
            echo "Backend API available at: http://localhost:5000"
            echo "Frontend available at: http://localhost:3000"
        }
        failure {
            echo 'Pipeline failed. Check logs for details.'
        }
    }
}