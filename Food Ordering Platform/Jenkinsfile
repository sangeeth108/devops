pipeline {
    agent any
    
    environment {
        DOCKER_REGISTRY = credentials('your-docker-registry')
        KUBE_CONFIG = credentials('kubeconfig')
        HELM_CHART = 'my-app-chart'
    }

    stages {
        stage('Build & Test') {
            steps {
                script {
                    // Install dependencies and run tests
                    sh 'npm install'
                    sh 'npm test'
                    
                    // Build Next.js
                    sh 'cd client && npm run build'
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                script {
                    // Build Express.js image
                    docker.build("${DOCKER_REGISTRY}/express-app:${env.BUILD_ID}")
                    
                    // Build Next.js image
                    docker.build("${DOCKER_REGISTRY}/nextjs-app:${env.BUILD_ID}")
                }
            }
        }
        
        stage('Push Docker Images') {
            steps {
                script {
                    docker.withRegistry('https://your-docker-registry', 'docker-credentials') {
                        docker.image("${DOCKER_REGISTRY}/express-app:${env.BUILD_ID}").push()
                        docker.image("${DOCKER_REGISTRY}/nextjs-app:${env.BUILD_ID}").push()
                    }
                }
            }
        }
        
        stage('Deploy to Kubernetes') {
            steps {
                script {
                    // Configure kubectl
                    withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
                        // Update Helm chart
                        sh "helm upgrade --install my-app ${HELM_CHART} \
                            --set express.image.tag=${env.BUILD_ID} \
                            --set nextjs.image.tag=${env.BUILD_ID}"
                    }
                }
            }
        }
    }
    
    post {
        always {
            cleanWs()
        }
        failure {
            slackSend channel: '#devops', message: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} failed"
        }
        success {
            slackSend channel: '#devops', message: "Build ${env.JOB_NAME} #${env.BUILD_NUMBER} succeeded"
        }
    }
}
